[
{
"start": 0.0,
"end": 1.24,
"text": "What are you talking about?"
},
{
"start": 1.5,
"end": 2.66,
"text": "Don't you remember?"
},
{
"start": 4.79,
"end": 7.13,
"text": "I threw poor little Curtis in there."
},
{
"start": 7.93,
"end": 9.33,
"text": "But he never came out."
},
{
"start": 10.23,
"end": 11.05,
"text": "You did."
},
{
"start": 11.75,
"end": 14.2,
"text": "You're a replica."
},
{
"start": 15.34,
"end": 17.58,
"text": "You're some kind of imitation human."
},
{
"start": 18.04,
"end": 22.36,
"text": "Those things on the other side put together out of slime and dead rats."
},
{
"start": 23.1,
"end": 25.22,
"text": "And a little bit of Curtis' brain tissue."
},
{
"start": 25.22,
"end": 28.56,
"text": "Oh, I told your father it was you."
},
{
"start": 29.3,
"end": 30.94,
"text": "That there'd been a terrible accident."
},
{
"start": 31.5,
"end": 32.48,
"text": "And he believed me."
},
{
"start": 32.62,
"end": 34.62,
"text": "Because he wanted to."
},
{
"start": 34.62,
"end": 35.62,
"text": "No."
},
{
"start": 35.62,
"end": 38.62,
"text": "Yes. I'm afraid so."
},
{
"start": 38.62,
"end": 43.16,
"text": "You started remembering a year ago."
},
{
"start": 43.16,
"end": 46.16,
"text": "That's why we put you in the hospital. To observe you."
},
{
"start": 46.16,
"end": 49.16,
"text": "I should say to observe you more closely."
},
{
"start": 49.16,
"end": 54.16,
"text": "You see, we've been watching you like a bug in a jar."
},
{
"start": 54.16,
"end": 61.9,
"text": "Ever since those things spit you out of a threshold."
},
{
"start": 61.9,
"end": 62.9,
"text": "Where is he?"
},
{
"start": 62.9,
"end": 72.58,
"text": "Use my sense."
},
{
"start": 72.58,
"end": 75.26,
"text": "Cudges Craig, at your service."
}
]