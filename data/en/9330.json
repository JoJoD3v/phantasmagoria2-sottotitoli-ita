[
{
"start": 1.04,
"end": 3.04,
"text": "Hey, Curtis, what's up?"
},
{
"start": 3.04,
"end": 5.04,
"text": "Don't tell me there's been another murder."
},
{
"start": 5.04,
"end": 7.04,
"text": "Okay, I won't tell you."
},
{
"start": 7.04,
"end": 10.35,
"text": "But that won't make the dead guy go away."
},
{
"start": 10.35,
"end": 12.35,
"text": "Aw, geez, man."
},
{
"start": 12.35,
"end": 14.35,
"text": "You work at the freakin' Bates Motel."
},
{
"start": 14.35,
"end": 18.35,
"text": "Hi, who was it this time? Anybody I know?"
},
{
"start": 18.35,
"end": 20.35,
"text": "My manager, Tom Revell."
},
{
"start": 20.35,
"end": 22.35,
"text": "Tom?"
},
{
"start": 22.35,
"end": 26.35,
"text": "No way, man. He was a good tipper."
},
{
"start": 26.35,
"end": 28.35,
"text": "He was a nice dude, too."
}
