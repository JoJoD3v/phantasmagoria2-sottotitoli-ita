[
{
"start": 4.11,
"end": 21.52,
"text": "I'm the same."
},
{
"start": 21.52,
"end": 22.52,
"text": "Are you not?"
},
{
"start": 22.52,
"end": 24.52,
"text": "But you know who your mother was."
},
{
"start": 24.52,
"end": 27.02,
"text": "Not always."
},
{
"start": 27.02,
"end": 28.02,
"text": "You're right."
},
{
"start": 28.02,
"end": 33.02,
"text": "She wasn't always the violent, jibbering, drooling lunatic she became."
},
{
"start": 33.02,
"end": 34.02,
"text": "Was she?"
},
{
"start": 34.02,
"end": 35.02,
"text": "You drove her to her."
},
{
"start": 35.02,
"end": 37.02,
"text": "I did not!"
},
{
"start": 37.02,
"end": 39.02,
"text": "I was only six years old!"
},
{
"start": 39.02,
"end": 40.02,
"text": "Yes."
},
{
"start": 40.02,
"end": 46.02,
"text": "A six year old little monster who drove his poor mother to madness and finally to suicide."
},
{
"start": 46.02,
"end": 47.52,
"text": "No!"
},
{
"start": 47.52,
"end": 56.08,
"text": "Freak."
